APP_DEBUG = true

# 可选：站点根 URL（无尾斜杠），用于头像等资源的绝对地址；不设则取当前请求域名
# APP_URL = https://example.com

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

DEFAULT_LANG = zh-cn

# opaque access_token 缓存 TTL（秒），默认 3600
ACCESS_TOKEN_TTL = 3600

# refresh_token 有效期（秒）：未勾选「记住我」默认 7 天
REFRESH_TOKEN_TTL_SESSION = 604800

# refresh_token 有效期（秒）：勾选「记住我」默认 30 天
REFRESH_TOKEN_TTL_REMEMBER = 2592000
