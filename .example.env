APP_DEBUG = true
DEFAULT_LANG = zh-cn
# 可选：站点根 URL（无尾斜杠），用于头像等资源的绝对地址；不设则取当前请求域名
# APP_URL = https://example.com
# 可选：可信反向代理 IP（逗号分隔，支持 CIDR）。有前置 LB/CDN 时配置，
# 仅当 REMOTE_ADDR 属于该列表时才采信 X-Real-IP / X-Forwarded-For。
# 浏览器直连 nginx→php-fpm 时不必配置（REMOTE_ADDR 已是客户端 IP）。
# PROXY_SERVER_IP = 127.0.0.1,10.0.0.0/8
# 登录令牌 TTL / 防暴破见 config/admin_login.php



DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX = ga_

[REDIS]
PASSWORD=xx

[FEISHU]
APP_ID=xxx
APP_SECRET=xxx
REDIRECT_URI=http://xxx/login?login_from=feishu-web


