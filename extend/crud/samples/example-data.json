{
  "module": "example",
  "entity": "Data",
  "table": "example_data",
  "title": "示例数据",
  "moduleTitle": "示例",
  "menuIcon": "el:DocumentCopy",
  "menuSort": 15,
  "menus": [
    {
      "type": "menu",
      "path": "example",
      "title": "示例",
      "icon": "el:DocumentCopy",
      "sort": 15,
      "enabled": true
    },
    {
      "type": "view",
      "path": "data",
      "title": "示例数据",
      "enabled": true
    }
  ],
  "paths": {
    "controller": "example/Data.php",
    "model": "example/Data.php",
    "validate": "example/Data.php",
    "apis": "example/data.ts",
    "viewsDir": "example/data/"
  },
  "generateAuth": true,
  "writeMode": "skip",
  "maps": {
    "STATUS_MAP": {
      "1": {
        "label": "启用",
        "type": "success"
      },
      "0": {
        "label": "禁用",
        "type": "info"
      }
    },
    "LEVEL_MAP": {
      "1": {
        "label": "普通",
        "type": "info"
      },
      "2": {
        "label": "重要",
        "type": "warning"
      },
      "3": {
        "label": "紧急",
        "type": "danger"
      }
    }
  },
  "options": {
    "EXTRA_OPTIONS": [
      {
        "value": "notify",
        "label": "通知"
      },
      {
        "value": "export",
        "label": "导出"
      },
      {
        "value": "audit",
        "label": "审计"
      }
    ]
  },
  "fields": [
    {
      "prop": "id",
      "label": "ID",
      "column": {
        "type": "bigint",
        "unsigned": true,
        "nullable": false,
        "autoIncrement": true,
        "primary": true
      },
      "list": {
        "render": "text",
        "width": 72
      },
      "form": false
    },
    {
      "prop": "title",
      "label": "标题",
      "column": {
        "type": "varchar",
        "length": 100,
        "nullable": false
      },
      "list": {
        "render": "text",
        "minWidth": 140
      },
      "search": {
        "mode": "keyword"
      },
      "form": {
        "render": "input",
        "required": true,
        "placeholder": "请输入标题",
        "maxLength": 100
      }
    },
    {
      "prop": "code",
      "label": "编码",
      "column": {
        "type": "varchar",
        "length": 50,
        "nullable": false,
        "unique": true
      },
      "list": {
        "render": "text",
        "minWidth": 120
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "input",
        "required": true,
        "placeholder": "字母、数字、下划线、中划线",
        "maxLength": 50
      }
    },
    {
      "prop": "category_id",
      "label": "分类",
      "column": {
        "type": "bigint",
        "unsigned": true,
        "nullable": true,
        "default": null
      },
      "relation": {
        "type": "belongs_to"
      },
      "list": {
        "render": "tag",
        "relationProp": "category.name",
        "width": 110
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "remote_select",
        "optionsKey": "example.Category/list"
      }
    },
    {
      "prop": "tag_ids",
      "label": "标签",
      "relation": {
        "type": "belongs_to_many",
        "pivotTable": "example_data_tag",
        "foreignKey": "data_id",
        "relatedKey": "tag_id"
      },
      "list": {
        "render": "tags",
        "relationProp": "tags",
        "minWidth": 160
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "remote_multi_select",
        "optionsKey": "example.Tag/list"
      }
    },
    {
      "prop": "content",
      "label": "内容",
      "column": {
        "type": "text",
        "nullable": true
      },
      "form": {
        "render": "textarea",
        "placeholder": "长文本内容",
        "maxLength": 2000
      }
    },
    {
      "prop": "amount",
      "label": "金额",
      "column": {
        "type": "decimal",
        "precision": 12,
        "scale": 2,
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "number",
        "width": 100
      },
      "form": {
        "render": "number",
        "numberMin": 0,
        "numberMax": 9999999,
        "numberStep": 0.01
      },
      "search": {
        "mode": "advanced"
      }
    },
    {
      "prop": "quantity",
      "label": "数量",
      "column": {
        "type": "int",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "number",
        "width": 80
      },
      "form": {
        "render": "number",
        "numberMin": 0,
        "numberMax": 99999
      }
    },
    {
      "prop": "is_top",
      "label": "置顶",
      "column": {
        "type": "tinyint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "bool",
        "width": 72
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "switch"
      }
    },
    {
      "prop": "status",
      "label": "状态",
      "column": {
        "type": "tinyint",
        "nullable": false,
        "default": 1
      },
      "list": {
        "render": "status",
        "statusMapKey": "STATUS_MAP",
        "width": 88
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "radio",
        "statusMapKey": "STATUS_MAP"
      }
    },
    {
      "prop": "level",
      "label": "等级",
      "column": {
        "type": "tinyint",
        "nullable": false,
        "default": 1
      },
      "list": {
        "render": "tag",
        "statusMapKey": "LEVEL_MAP",
        "width": 88
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "select",
        "statusMapKey": "LEVEL_MAP"
      }
    },
    {
      "prop": "color",
      "label": "颜色",
      "column": {
        "type": "varchar",
        "length": 32,
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "color",
        "width": 72
      },
      "form": {
        "render": "color"
      }
    },
    {
      "prop": "cover",
      "label": "封面",
      "column": {
        "type": "varchar",
        "length": 255,
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "image",
        "width": 88
      },
      "form": {
        "render": "image"
      }
    },
    {
      "prop": "publish_time",
      "label": "发布时间",
      "column": {
        "type": "bigint",
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "datetime",
        "width": 170
      },
      "form": {
        "render": "datetime"
      },
      "search": {
        "mode": "advanced"
      }
    },
    {
      "prop": "expire_date",
      "label": "过期日期",
      "column": {
        "type": "date",
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "text",
        "width": 120
      },
      "form": {
        "render": "date"
      },
      "search": {
        "mode": "advanced"
      }
    },
    {
      "prop": "extra",
      "label": "扩展项",
      "column": {
        "type": "json",
        "nullable": true
      },
      "list": {
        "render": "tags",
        "optionsKey": "EXTRA_OPTIONS",
        "minWidth": 140
      },
      "form": {
        "render": "multi_select",
        "optionsKey": "EXTRA_OPTIONS"
      }
    },
    {
      "prop": "remark",
      "label": "备注",
      "column": {
        "type": "varchar",
        "length": 500,
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "text",
        "minWidth": 140
      },
      "search": {
        "mode": "keyword"
      },
      "form": {
        "render": "textarea",
        "placeholder": "可选",
        "maxLength": 500
      }
    },
    {
      "prop": "sort",
      "label": "排序",
      "column": {
        "type": "int",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "number",
        "width": 72
      },
      "form": {
        "render": "number",
        "numberMin": 0,
        "numberMax": 99999
      }
    },
    {
      "prop": "create_time",
      "label": "创建时间",
      "column": {
        "type": "bigint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "datetime",
        "width": 170
      },
      "form": false
    },
    {
      "prop": "update_time",
      "label": "更新时间",
      "column": {
        "type": "bigint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "datetime"
      },
      "form": false
    }
  ]
}
