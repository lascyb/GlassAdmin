{
  "module": "demo",
  "entity": "Item",
  "table": "demo_item",
  "title": "演示条目",
  "moduleTitle": "演示",
  "menuIcon": "el:Box",
  "menuSort": 0,
  "menus": [
    {
      "type": "menu",
      "path": "demo",
      "title": "演示",
      "icon": "el:Box",
      "sort": 0,
      "enabled": true
    },
    {
      "type": "view",
      "path": "item",
      "title": "演示条目",
      "enabled": true
    }
  ],
  "paths": {
    "controller": "demo/Item.php",
    "model": "demo/Item.php",
    "validate": "demo/Item.php",
    "apis": "demo/item.ts",
    "viewsDir": "demo/item/"
  },
  "generateAuth": true,
  "writeMode": "skip",
  "maps": {
    "STATUS_MAP": {
      "1": {
        "label": "启用",
        "type": "success"
      },
      "0": {
        "label": "禁用",
        "type": "info"
      }
    }
  },
  "fields": [
    {
      "prop": "id",
      "label": "ID",
      "column": {
        "type": "bigint",
        "unsigned": true,
        "nullable": false,
        "autoIncrement": true,
        "primary": true
      },
      "list": {
        "render": "text",
        "width": 72
      },
      "form": false
    },
    {
      "prop": "title",
      "label": "标题",
      "column": {
        "type": "varchar",
        "length": 100,
        "nullable": false
      },
      "list": {
        "render": "text",
        "minWidth": 140
      },
      "search": {
        "mode": "keyword"
      },
      "form": {
        "render": "input",
        "required": true,
        "placeholder": "请输入标题",
        "maxLength": 100
      }
    },
    {
      "prop": "code",
      "label": "编码",
      "column": {
        "type": "varchar",
        "length": 50,
        "nullable": false,
        "unique": true
      },
      "list": {
        "render": "text",
        "minWidth": 120
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "input",
        "required": true,
        "placeholder": "字母、数字、下划线、中划线",
        "maxLength": 50
      }
    },
    {
      "prop": "category_id",
      "label": "分类",
      "column": {
        "type": "bigint",
        "unsigned": true,
        "nullable": true,
        "default": null
      },
      "relation": {
        "type": "belongs_to"
      },
      "list": {
        "render": "tag",
        "relationProp": "category.name",
        "width": 110
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "remote_select",
        "optionsKey": "example.Category/list"
      }
    },
    {
      "prop": "quantity",
      "label": "数量",
      "column": {
        "type": "int",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "number",
        "width": 80
      },
      "form": {
        "render": "number",
        "numberMin": 0,
        "numberMax": 99999
      }
    },
    {
      "prop": "is_top",
      "label": "置顶",
      "column": {
        "type": "tinyint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "bool",
        "width": 72
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "switch"
      }
    },
    {
      "prop": "status",
      "label": "状态",
      "column": {
        "type": "tinyint",
        "nullable": false,
        "default": 1
      },
      "list": {
        "render": "status",
        "statusMapKey": "STATUS_MAP",
        "width": 88
      },
      "search": {
        "mode": "advanced"
      },
      "form": {
        "render": "radio",
        "statusMapKey": "STATUS_MAP"
      }
    },
    {
      "prop": "cover",
      "label": "封面",
      "column": {
        "type": "varchar",
        "length": 255,
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "image",
        "width": 88
      },
      "form": {
        "render": "image"
      }
    },
    {
      "prop": "publish_time",
      "label": "发布时间",
      "column": {
        "type": "bigint",
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "datetime",
        "width": 170
      },
      "form": {
        "render": "datetime"
      }
    },
    {
      "prop": "remark",
      "label": "备注",
      "column": {
        "type": "varchar",
        "length": 500,
        "nullable": true,
        "default": null
      },
      "list": {
        "render": "text",
        "minWidth": 140
      },
      "search": {
        "mode": "keyword"
      },
      "form": {
        "render": "textarea",
        "placeholder": "可选",
        "maxLength": 500
      }
    },
    {
      "prop": "sort",
      "label": "排序",
      "column": {
        "type": "int",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "number",
        "width": 72
      },
      "form": {
        "render": "number",
        "numberMin": 0,
        "numberMax": 99999
      }
    },
    {
      "prop": "create_time",
      "label": "创建时间",
      "column": {
        "type": "bigint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "datetime",
        "width": 170
      },
      "form": false
    },
    {
      "prop": "update_time",
      "label": "更新时间",
      "column": {
        "type": "bigint",
        "nullable": false,
        "default": 0
      },
      "list": {
        "render": "datetime"
      },
      "form": false
    }
  ]
}
